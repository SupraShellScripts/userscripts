{
  "schemaVersion": 1,
  "purpose": "Public, anonymous, read-only site drift observation; NOT userscript functional qualification for unreleased/private scripts.",
  "policy": {
    "authentication": "none",
    "network": "navigation only; never click vendor buttons or download files",
    "capturePageText": false,
    "captureCookies": false,
    "storeScreenshotsByDefault": false,
    "resultsRetentionDays": 3,
    "baselineApproval": "manual"
  },
